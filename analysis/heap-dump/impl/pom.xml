<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.eclipse.jifa</groupId>
    <artifactId>jifa</artifactId>
        <version>0.3.0-SNAPSHOT</version>
        <relativePath>../../../pom.xml</relativePath>
  </parent>
  <artifactId>heap-dump-analysis-impl</artifactId>
  <properties>
    <mat.deps.dir>${maven.multiModuleProjectDirectory}/analysis/heap-dump/provider/src/main/resources/mat-deps</mat.deps.dir>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.eclipse.jifa</groupId>
      <artifactId>heap-dump-analysis-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jifa</groupId>
      <artifactId>heap-dump-analysis-hook</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jifa.mat</groupId>
      <artifactId>mat-api</artifactId>
      <version>1.16.1</version>
      <scope>system</scope>
      <systemPath>${mat.deps.dir}/org.eclipse.mat.api_1.16.1.202501091339.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jifa.mat</groupId>
      <artifactId>mat-parser</artifactId>
      <version>1.16.1</version>
      <scope>system</scope>
      <systemPath>${mat.deps.dir}/org.eclipse.mat.parser_1.16.1.202501091339.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jifa.mat</groupId>
      <artifactId>mat-report</artifactId>
      <version>1.16.1</version>
      <scope>system</scope>
      <systemPath>${mat.deps.dir}/org.eclipse.mat.report_1.16.1.202501091339.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jifa.mat</groupId>
      <artifactId>mat-hprof</artifactId>
      <version>1.16.1</version>
      <scope>system</scope>
      <systemPath>${mat.deps.dir}/org.eclipse.mat.hprof_1.16.1.202501091339.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jifa.mat</groupId>
      <artifactId>equinox-osgi</artifactId>
      <version>3.22.0</version>
      <scope>system</scope>
      <systemPath>${mat.deps.dir}/org.eclipse.osgi-3.22.0.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jifa.mat</groupId>
      <artifactId>mat-calcite-plugin</artifactId>
      <version>1.6.3</version>
      <scope>system</scope>
      <systemPath>${mat.deps.dir}/MatCalcitePlugin_1.6.3.jar</systemPath>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <testExcludes>
            <testExclude>**/TestHeapDumpAnalyzerImpl.java</testExclude>
          </testExcludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Bundle-SymbolicName>org.eclipse.jifa.hda.implementation; singleton:=true</Bundle-SymbolicName>
              <Require-Bundle>org.eclipse.mat.api,org.eclipse.mat.parser,org.eclipse.mat.hprof,org.eclipse.osgi,MatCalcitePlugin</Require-Bundle>
              <Bundle-Activator>org.eclipse.jifa.hda.impl.Activator</Bundle-Activator>
              <Import-Package>org.eclipse.mat.snapshot,org.eclipse.mat.util,org.eclipse.mat.query,org.eclipse.mat.parser.model,org.eclipse.mat.hprof.extension</Import-Package>
              <Bundle-Version>${osgi.bundle.version}</Bundle-Version>
            </manifestEntries>
          </archive>
        </configuration>
        <executions>
          <execution>
            <id>package-for-provider-tests</id>
            <phase>process-test-classes</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>reactor</classifier>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
