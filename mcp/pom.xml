<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.eclipse.jifa</groupId>
        <artifactId>jifa</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>
    <artifactId>jifa-mcp</artifactId>
    <name>Jifa MCP Server</name>
    <properties>
        <mat.deps.dir>${maven.multiModuleProjectDirectory}/analysis/heap-dump/provider/src/main/resources/mat-deps</mat.deps.dir>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.eclipse.jifa</groupId>
            <artifactId>analysis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jifa</groupId>
            <artifactId>gc-log-analysis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jifa</groupId>
            <artifactId>thread-dump-analysis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jifa</groupId>
            <artifactId>jfr</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jifa</groupId>
            <artifactId>heap-dump-analysis-provider</artifactId>
            <version>${project.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.jifa.mat</groupId>
            <artifactId>equinox-osgi</artifactId>
            <version>3.22.0</version>
            <scope>system</scope>
            <systemPath>${mat.deps.dir}/org.eclipse.osgi-3.22.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <finalName>jifa-mcp</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>org.eclipse.jifa.mcp.McpApplication</mainClass>
                    <includeSystemScope>true</includeSystemScope>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
